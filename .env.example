# =============================================================================
# WhatsApp AI Dental Receptionist SaaS — Environment Variables Template
# =============================================================================
# Duplicate this file to .env.local for local development.
# For production (Vercel + Railway/Render), configure these in your dashboard.
# =============================================================================

# ===== SUPABASE CONFIGURATION =====
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== META WHATSAPP CLOUD API =====
# Get these from Meta Developers -> WhatsApp -> API Setup & Configuration
META_VERIFY_TOKEN=your_secure_random_webhook_verify_token_here
META_ACCESS_TOKEN=EAAG...permanent_or_system_user_token...
META_PHONE_NUMBER_ID=109876543210987
META_WHATSAPP_BUSINESS_ID=101234567890123

# ===== GOOGLE SERVICE ACCOUNT (Used for BOTH Sheets & Calendar) =====
# Create in Google Cloud Console -> IAM & Admin -> Service Accounts
# Enable Google Sheets API & Google Calendar API in Google Cloud Console
GOOGLE_CLIENT_EMAIL=clinic-service-account@your-gcp-project.iam.gserviceaccount.com
# Keep newlines escaped as \n inside double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ===== GOOGLE CALENDAR (Dynamic per clinic) =====
# Share this Google Calendar with GOOGLE_CLIENT_EMAIL as "Make changes to events"
GOOGLE_CALENDAR_ID=your_clinic_calendar_id@group.calendar.google.com

# ===== GOOGLE SHEETS PRIMARY DATABASE (Dynamic per clinic) =====
# Share this Google Sheet with GOOGLE_CLIENT_EMAIL as "Editor"
# Extracted from URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0J_your_sheet_id_here

# ===== GOOGLE GEMINI AI =====
# Get from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ===== CLINIC DEFAULT CONFIGURATION (White-Label Defaults) =====
# Can also be modified dynamically at runtime in the Admin Settings Dashboard
CLINIC_NAME="SmileCare Dental & Implant Clinic"
CLINIC_DOCTOR="Dr. A. Sharma (BDS, MDS Oral & Maxillofacial)"
CLINIC_ADDRESS="Suite 402, Dental Care Plaza, Metro Station Road"
CLINIC_PHONE="+91 98765 43210"
CLINIC_TIMINGS_START=09:00
CLINIC_TIMINGS_END=18:00
CLINIC_LUNCH_START=13:00
CLINIC_LUNCH_END=14:00
CLINIC_WEEKLY_OFF=Sunday
CLINIC_CONSULTATION_FEE=500

# ===== SERVER & NETWORKING =====
PORT=3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
NODE_ENV=development
